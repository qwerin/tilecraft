# Proměnné stacku v Portaineru (nebo .env vedle docker-compose.yml).
POSTGRES_PASSWORD=zmente-me
DOMAIN=tilecraft.svobo.cz
# Registrace nové firmy jen s kódem: TILECRAFT_SIGNUP_CODE, nebo jednorázový kód, který vydá superadmin
TILECRAFT_ALLOW_SIGNUP=false
TILECRAFT_SIGNUP_CODE=zmente-me-dlouhy-nahodny-kod
# Superadmini (e-maily oddělené čárkou): vidí a otevřou všechny firmy, vydávají registrační kódy
TILECRAFT_SUPERADMINS=spravce@example.cz
TILECRAFT_SEED_DEMO=false
# production | test (testovací instance: růžový motiv a štítek TEST)
TILECRAFT_ENV=production
# E-maily (cenové nabídky, zkušební e-mail na stránce E-maily). Výchozí stav: NEODESÍLAJÍ SE, jen se uloží na stránku E-maily.
# E-maily lze místo těchto proměnných nastavit ve Správě aplikace (/admin); zadané proměnné mají přednost.
# Ostré odesílání zapne TILECRAFT_EMAIL_LIVE=true (testovací instance neodesílá nikdy).
TILECRAFT_EMAIL_LIVE=false
# Gmail: adresa účtu a heslo aplikace (Účet Google → Zabezpečení → Dvoufázové ověření → Hesla aplikací)
TILECRAFT_GMAIL_USER=
TILECRAFT_GMAIL_APP_PASSWORD=
# … nebo jiný SMTP server (ne zároveň s Gmailem)
TILECRAFT_SMTP_HOST=
TILECRAFT_SMTP_PORT=587
TILECRAFT_SMTP_USER=
TILECRAFT_SMTP_PASSWORD=
# odesílatel, např. "Obklady Novák <obklady@gmail.com>" (u Gmailu výchozí = TILECRAFT_GMAIL_USER; jiná adresa musí být v Gmailu alias)
TILECRAFT_SMTP_FROM=
# šifrování: starttls (výchozí) | tls (port 465) | none (jen lokální relay)
TILECRAFT_SMTP_TLS=
# volitelný DKIM podpis aplikací (všechny tři, nebo nic); u Gmailu podepisuje Google
TILECRAFT_DKIM_DOMAIN=
TILECRAFT_DKIM_SELECTOR=
TILECRAFT_DKIM_PRIVATE_KEY_FILE=
# Klíč šifrující uložená hesla SMTP (32 bajtů base64/hex); prázdné = vygeneruje se do svazku dat (/data/secret.key)
TILECRAFT_SECRET_KEY=
# Musí odpovídat konfiguraci Traefiku na VPS
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=letsencrypt
# Tag image (latest | sha-xxxxxxx | 1.2.3)
TILECRAFT_TAG=latest
# Zálohy (docs/BACKUP.md): adresář na hostiteli, čas (cron, Europe/Prague), kolik denních a měsíčních ponechat
BACKUP_DIR=/srv/tilecraft-backups
BACKUP_SCHEDULE=30 2 * * *
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
